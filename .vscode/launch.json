{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Shortener",
            "type": "go",
            "request": "launch",
            // Запускаем приложение из корня проекта
            "cwd": "${workspaceFolder}",
            // Подхватываем .env
            "envFile": "${workspaceFolder}/.env",
            // Подхватываем самих переменных окружения из envFile
            "env": {},
            // Указываем путь до главного пакета
            "program": "${workspaceFolder}/cmd/shortener",
            // Делает дебаг стабильнее
            "mode": "debug"
        }
    ]
}